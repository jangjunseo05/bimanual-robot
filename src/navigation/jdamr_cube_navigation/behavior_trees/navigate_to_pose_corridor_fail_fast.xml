<!--
  Corridor navigation plans once, then stops and waits on a transient failure
  before restarting the same path. Recovery is bounded and never clears a
  costmap, spins, backs up, or replans an already-created path.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="PlanOnceThenFollowCorridorPath">
      <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
      <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
      <GoalCheckerSelector selected_goal_checker="{selected_goal_checker}" default_goal_checker="position_goal_checker" topic_name="goal_checker_selector"/>
      <RecoveryNode number_of_retries="60" name="ComputeCorridorPathRetry">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}" server_timeout="3000"/>
        <Sequence name="WaitForCorridorPlanner">
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
          <Wait wait_duration="1.0"/>
        </Sequence>
      </RecoveryNode>
      <RecoveryNode number_of_retries="60" name="FollowCorridorPathRetry">
        <FollowPath path="{path}" controller_id="{selected_controller}" goal_checker_id="{selected_goal_checker}" error_code_id="{follow_path_error_code}" server_timeout="3000"/>
        <Sequence name="WaitForCorridorController">
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <Wait wait_duration="1.0"/>
        </Sequence>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
