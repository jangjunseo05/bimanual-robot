<!--
  NavFn plans the staging leg once. A transient planner failure waits one
  second before retrying, but a successful path is never recomputed during
  this goal. RPP stops on a controller failure, waits, and restarts that same
  path. The position-only goal checker and parent safety guards are unchanged.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="PlanOnceThenFollowStagingPath">
      <RecoveryNode number_of_retries="60" name="ComputeStagingPathRetry">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}" server_timeout="3000"/>
        <Sequence name="WaitForStagingPlanner">
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
          <Wait wait_duration="1.0"/>
        </Sequence>
      </RecoveryNode>
      <RecoveryNode number_of_retries="60" name="FollowStagingPathRetry">
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="staging_position_checker" error_code_id="{follow_path_error_code}" server_timeout="3000"/>
        <Sequence name="WaitForStagingController">
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <Wait wait_duration="1.0"/>
        </Sequence>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
